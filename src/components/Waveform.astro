---
interface Props {
  class?: string;
  bars?: number;
}
const { class: className = '', bars = 51 } = Astro.props;

// One authentic cycle of the official fonUFAL symbol (17 bars, gray with a
// red and a blue accent), heights normalized 0-100 from the exact vector
// geometry in marca-fonUFAL.ai. Tiled to fill an arbitrary bar count so it
// still reads as a soundwave across a full-width hero strip.
const OFFICIAL_HEIGHTS = [12, 25.5, 57.5, 75.8, 100, 69.9, 55.8, 25.6, 58.1, 88.9, 57, 72.1, 92.3, 54.9, 58.4, 33.8, 12.2];
const RED_INDEX = 4;
const BLUE_INDEX = 12;

const barWidth = 100 / bars;
---
<svg class={`waveform ${className}`} viewBox={`0 0 100 100`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
  {Array.from({ length: bars }, (_, i) => {
    const cycleIndex = i % OFFICIAL_HEIGHTS.length;
    const h = OFFICIAL_HEIGHTS[cycleIndex];
    const fill = cycleIndex === RED_INDEX ? 'var(--fon-red)' : cycleIndex === BLUE_INDEX ? 'var(--fon-blue)' : 'var(--fon-gray)';
    return (
      <rect
        x={i * barWidth + barWidth * 0.18}
        y={100 - h}
        width={barWidth * 0.64}
        height={h}
        rx={barWidth * 0.3}
        fill={fill}
      />
    );
  })}
</svg>
