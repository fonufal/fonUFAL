---
import { SITE_TITLE, LOGO } from '../consts';
import { url } from '../utils/paths';
const nav = [
  ['Início','/'], ['Pesquisa','/projects'], ['Pessoas','/team'],
  ['Publicações','/publications'], ['Notícias','/noticias'], ['Contato','/contato']
];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname.slice(base.length) || '/';
const isActive = (path: string) => path === '/' ? currentPath === '/' : currentPath.startsWith(path);
---
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={url('/')} aria-label={`${SITE_TITLE} — início`}>
      <img src={url(LOGO)} alt="fonUFAL" width="220" height="51" style="width:180px;height:auto" />
      <span class="brand-mark">Fonética<br/>&amp; Fonologia</span>
    </a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
    <label for="nav-toggle" class="nav-toggle-label" aria-label="Abrir menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </label>
    <nav class="site-nav" aria-label="Navegação principal">
      {nav.map(([label,path]) => <a href={url(path)} aria-current={isActive(path) ? 'page' : undefined} class={isActive(path) ? 'is-active' : undefined}>{label}</a>)}
    </nav>
  </div>
</header>
