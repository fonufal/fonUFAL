---
import BaseHead from '../components/BaseHead.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import { CONTACT_EMAIL, SITE_TITLE } from '../consts';
---
<html lang="pt-BR"><head><BaseHead title={`Contato | ${SITE_TITLE}`} description="Contato do fonUFAL" /></head><body><Header/><main><section class="hero"><p class="eyebrow">Contato</p><h1>Fale com o fonUFAL</h1><p class="lead">E-mail: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p></section><section class="section"><div class="callout">O formulário do WordPress não será copiado automaticamente. A solução definitiva será escolhida para funcionar sem backend WordPress e sem expor dados desnecessários.</div></section></main><Footer/></body></html>
