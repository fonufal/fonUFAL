---
import BaseHead from '../../components/BaseHead.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro';
import projects from '../../data/projects.json'; import { SITE_TITLE } from '../../consts'; import { url } from '../../utils/paths'; import { statusClass } from '../../utils/status';
const ordered=[...projects].sort((a,b)=>b.year-a.year);
---
<html lang="en"><head><BaseHead title={`Research | ${SITE_TITLE}`} description="fonUFAL research projects" /></head><body><Header lang="en"/><main><section class="hero"><div class="hero-content"><p class="eyebrow">Research</p><h1>Projects</h1><p class="lead">Ongoing projects, projects under review, and proposals in development are explicitly distinguished.</p></div></section><section class="section"><div class="grid">{ordered.map(p=><article class="card"><span class={`badge ${statusClass(p.status_en || p.status)}`}>{p.status_en || p.status}</span><p class="meta">{p.period || p.year}{p.reference ? ` · ${p.reference}` : ''}</p><h3><a href={url(`/en/projects/${p.id}`)}>{p.title_en || p.title}</a></h3><p>{p.description_en || p.description}</p>{(p.funding_en || p.funding) && <p class="meta">{p.funding_en || p.funding}</p>}</article>)}</div></section></main><Footer lang="en"/></body></html>
