---
import BaseHead from '../../components/BaseHead.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import Waveform from '../../components/Waveform.astro'; import { CONTACT_EMAIL, SITE_TITLE } from '../../consts';
---
<html lang="en"><head><BaseHead title={`Contact | ${SITE_TITLE}`} description="Contact fonUFAL" /></head><body><Header lang="en"/><main><section class="hero"><div class="hero-content"><p class="eyebrow">Contact</p><h1>Get in touch with fonUFAL</h1><p class="lead">Email: <a class="btn btn--ghost" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p></div><Waveform class="hero-waveform" /></section><section class="section"><div class="callout"><h2>Contact form in preparation</h2><p>The WordPress form will not be copied automatically. A definitive solution will be chosen to work without a WordPress backend and without exposing unnecessary data.</p></div></section></main><Footer lang="en"/></body></html>
