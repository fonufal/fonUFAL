---
import BaseHead from '../../../components/BaseHead.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Waveform from '../../../components/Waveform.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../../../consts';
import { url } from '../../../utils/paths';

const posts = (await getCollection('blogEn')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<html lang="en">
<head><BaseHead title={`News | ${SITE_TITLE}`} description="News from fonUFAL" /></head>
<body><Header lang="en" /><main>
<section class="hero"><div class="hero-content"><p class="eyebrow">Updates · {posts.length} publications</p><h1>News</h1><p class="lead">Announcements, events, achievements, and activities from fonUFAL.</p></div><Waveform class="hero-waveform" /></section>
<section class="section"><div class="grid">{posts.map(p => {const topics=(p.data.tags ?? []).filter(t=>t.toLowerCase() !== 'news'); return <article class="card"><p class="meta">{p.data.pubDate.toLocaleDateString('en-GB', { timeZone: 'UTC' })}</p>{topics.length > 0 && <p class="topic-badges">{topics.map(t=><span class="badge badge--news">{t}</span>)}</p>}<h3><a href={url(`/en/news/${p.id}`)}>{p.data.title}</a></h3><p>{p.data.description}</p></article>})}</div></section>
</main><Footer lang="en" /></body></html>
