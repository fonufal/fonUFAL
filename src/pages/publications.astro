---
import BaseHead from '../components/BaseHead.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import Waveform from '../components/Waveform.astro'; import { SITE_TITLE } from '../consts';
---
<html lang="pt-BR"><head><BaseHead title={`Publicações | ${SITE_TITLE}`} description="Publicações do fonUFAL" /></head><body><Header/><main><section class="hero"><div class="hero-content"><p class="eyebrow">Produção científica</p><h1>Publicações</h1><p class="lead">O Astro Scholar oferece integração bibliográfica por BibTeX. A lista será preenchida após a reconciliação entre o WordPress, os registros do grupo e as fontes bibliográficas validadas.</p></div><Waveform class="hero-waveform" /></section></main><Footer/></body></html>
