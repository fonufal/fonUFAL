---
import BaseHead from '../components/BaseHead.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import { SITE_TITLE } from '../consts'; import { url } from '../utils/paths';
import publications from '../data/publications.json';
const ordered = [...publications].sort((a, b) => b.year - a.year);

function formatAuthors(authors: string[]) {
  if (authors.length <= 4) return authors.join(', ');
  return `${authors.slice(0, 4).join(', ')} et al.`;
}
---
<html lang="pt-BR"><head><BaseHead title={`Publicações | ${SITE_TITLE}`} description="Publicações do fonUFAL" /></head><body><Header/><main>
<section class="hero"><div class="hero-content"><p class="eyebrow">Produção científica · {publications.length} publicações</p><h1>Publicações</h1><p class="lead">Artigos e demais produções científicas do fonUFAL, com ênfase na produção recente de seus membros atuais.</p></div></section>
<section class="section"><div class="pub-list">
{ordered.map(p => (
  <article class="pub-item">
    <span class="badge">{p.year}</span>
    <h3><a href={p.url} target="_blank" rel="noopener">{p.title}</a></h3>
    <p class="meta">{formatAuthors(p.authors)}</p>
    <p>{p.journal}{p.volume && `, v. ${p.volume}`}{p.issue && `, n. ${p.issue}`}{p.pages && `, p. ${p.pages}`}.</p>
    {p.noticiaSlug && <p class="meta"><a href={url(`/noticias/${p.noticiaSlug}`)}>Ver notícia original →</a></p>}
  </article>
))}
</div></section>
</main><Footer/></body></html>
