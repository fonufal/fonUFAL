---
import BaseHead from '../components/BaseHead.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro';
import projects from '../data/projects.json'; import { SITE_TITLE } from '../consts'; import { url } from '../utils/paths'; import { statusClass } from '../utils/status';
const ordered=[...projects].sort((a,b)=>b.year-a.year);
---
<html lang="pt-BR"><head><BaseHead title={`Pesquisa | ${SITE_TITLE}`} description="Projetos de pesquisa do fonUFAL" /></head><body><Header/><main><section class="hero"><div class="hero-content"><p class="eyebrow">Pesquisa</p><h1>Projetos</h1><p class="lead">Projetos vigentes, em avaliação e propostas em desenvolvimento são distinguidos explicitamente.</p></div></section><section class="section"><div class="grid">{ordered.map(p=><article class="card"><span class={`badge ${statusClass(p.status)}`}>{p.status}</span><p class="meta">{p.period || p.year}{p.reference ? ` · ${p.reference}` : ''}</p><h3><a href={url(`/projects/${p.id}`)}>{p.title}</a></h3><p>{p.description}</p>{p.funding && <p class="meta">{p.funding}</p>}</article>)}</div></section></main><Footer/></body></html>
