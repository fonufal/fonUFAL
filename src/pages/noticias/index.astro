---
import BaseHead from '../../components/BaseHead.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import Waveform from '../../components/Waveform.astro'; import { getCollection } from 'astro:content'; import { SITE_TITLE } from '../../consts'; import { url } from '../../utils/paths';
const posts=(await getCollection('blog')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<html lang="pt-BR"><head><BaseHead title={`Notícias | ${SITE_TITLE}`} description="Notícias do fonUFAL" /></head><body><Header/><main><section class="hero"><div class="hero-content"><p class="eyebrow">Atualizações · {posts.length} publicações</p><h1>Notícias</h1><p class="lead">Arquivo de notícias preservado do WordPress e novas atualizações do grupo.</p></div><Waveform class="hero-waveform" /></section><section class="section"><div class="grid">{posts.map(p=><article class="card"><p class="meta">{p.data.pubDate.toLocaleDateString('pt-BR')}</p><h3><a href={url(`/noticias/${p.id}`)}>{p.data.title}</a></h3><p>{p.data.description}</p></article>)}</div></section></main><Footer/></body></html>
