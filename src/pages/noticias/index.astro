---
import BaseHead from '../../components/BaseHead.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import Waveform from '../../components/Waveform.astro'; import { getCollection } from 'astro:content'; import { SITE_TITLE } from '../../consts'; import { url } from '../../utils/paths';
const posts=(await getCollection('blog')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<html lang="pt-BR"><head><BaseHead title={`Notícias | ${SITE_TITLE}`} description="Notícias do fonUFAL" /></head><body><Header/><main><section class="hero"><div class="hero-content"><p class="eyebrow">Atualizações · {posts.length} publicações</p><h1>Notícias</h1><p class="lead">Comunicados, eventos, conquistas e atividades do fonUFAL ao longo do tempo.</p></div><Waveform class="hero-waveform" /></section><section class="section"><div class="grid">{posts.map(p=>{const topics=(p.data.tags ?? []).filter(t=>t.toLowerCase() !== 'notícias'); return <article class="card"><p class="meta">{p.data.pubDate.toLocaleDateString('pt-BR', { timeZone: 'UTC' })}</p>{topics.length > 0 && <p class="topic-badges">{topics.map(t=><span class="badge badge--news">{t}</span>)}</p>}<h3><a href={url(`/noticias/${p.id}`)}>{p.data.title}</a></h3><p>{p.data.description}</p></article>})}</div></section></main><Footer/></body></html>
