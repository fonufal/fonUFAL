---
import BaseHead from '../components/BaseHead.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import Waveform from '../components/Waveform.astro'; import authors from '../data/authors.json'; import { SITE_TITLE } from '../consts'; import { url } from '../utils/paths';

const categoryOrder = ['lider', 'pesquisador', 'estudante', 'egresso'];
const categoryTitles = {
  lider: 'Liderança',
  pesquisador: 'Pesquisadores',
  estudante: 'Estudantes',
  egresso: 'Egressos',
};
const groups = categoryOrder.map(cat => ({
  key: cat,
  title: categoryTitles[cat],
  members: authors.filter(a => a.category === cat),
})).filter(g => g.members.length > 0);

const linkLabels = { lattes: 'Lattes', researchgate: 'ResearchGate', email: 'Email', vcard: 'Vcard' };
---
<html lang="pt-BR"><head><BaseHead title={`Pessoas | ${SITE_TITLE}`} description="Pessoas do fonUFAL" /></head><body><Header/><main>
<section class="hero"><div class="hero-content"><p class="eyebrow">Pessoas · {authors.length} integrantes</p><h1>Equipe</h1><p class="lead">Líderes, pesquisadores, estudantes e egressos do fonUFAL, preservados do diretório oficial do grupo.</p></div><Waveform class="hero-waveform" /></section>
{groups.map(group => (
  <section class="section">
    <h2>{group.title}</h2>
    <div class="grid">
      {group.members.map(a => (
        <article class="card person-card">
          {a.photo && <img class="avatar" src={url(a.photo)} alt={a.name} width="96" height="96" loading="lazy" />}
          <h3>{a.name}</h3>
          {a.subRole && <span class="badge" style="margin-bottom:8px">{a.subRole}</span>}
          {a.bio && <p>{a.bio}</p>}
          <p class="person-links">
            {Object.entries(a.links).map(([key, href]) => (
              <a href={href} target="_blank" rel="noopener">{linkLabels[key] || key}</a>
            ))}
          </p>
        </article>
      ))}
    </div>
  </section>
))}
</main><Footer/></body></html>
