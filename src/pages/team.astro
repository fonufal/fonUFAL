---
import BaseHead from '../components/BaseHead.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import Waveform from '../components/Waveform.astro'; import authors from '../data/authors.json'; import { SITE_TITLE } from '../consts'; import { url } from '../utils/paths';

const categoryOrder = ['lider', 'pesquisador', 'estudante', 'egresso'];
const categoryTitles = {
  lider: 'Liderança',
  pesquisador: 'Pesquisadores',
  estudante: 'Estudantes',
  egresso: 'Egressos',
};
const studentRank = { Doutorado: 0, Mestrado: 1, Graduação: 2 };
const subRoleBadge = { Doutorado: 'badge--phd', Mestrado: 'badge--masters', Graduação: 'badge--undergrad' };
const groups = categoryOrder.map(cat => {
  let members = authors.filter(a => a.category === cat);
  if (cat === 'estudante') {
    members = [...members].sort((a, b) => {
      const rankDiff = (studentRank[a.subRole] ?? 99) - (studentRank[b.subRole] ?? 99);
      return rankDiff !== 0 ? rankDiff : a.name.localeCompare(b.name, 'pt-BR');
    });
  } else if (cat === 'egresso') {
    members = [...members].sort((a, b) => a.name.localeCompare(b.name, 'pt-BR'));
  }
  return { key: cat, title: categoryTitles[cat], members };
}).filter(g => g.members.length > 0);

const linkLabels = { lattes: 'Lattes', orcid: 'ORCID', email: 'Email' };
const linkOrder = ['lattes', 'orcid', 'email'];
---
<html lang="pt-BR"><head><BaseHead title={`Pessoas | ${SITE_TITLE}`} description="Pessoas do fonUFAL" /></head><body><Header/><main>
<section class="hero"><div class="hero-content"><p class="eyebrow">Pessoas · {authors.length} integrantes</p><h1>Equipe</h1><p class="lead">Líderes, pesquisadores, estudantes e egressos do fonUFAL.</p></div><Waveform class="hero-waveform" /></section>
{groups.map(group => (
  <section class="section">
    <div class="section-head"><h2>{group.title}</h2><span class="person-count">{group.members.length}</span></div>
    <div class="person-grid">
      {group.members.map(a => (
        <article class="person-tile">
          {a.photo && <img class="avatar avatar-lg" src={url(a.photo)} alt={a.name} width="96" height="96" loading="lazy" />}
          <h3>{a.name}</h3>
          <div class="person-foot">
            {a.subRole && <span class={`badge ${subRoleBadge[a.subRole] || ''}`}>{a.subRole}</span>}
            <p class="person-links">
              {linkOrder.filter(key => a.links[key]).map(key => (
                <a href={a.links[key]} target="_blank" rel="noopener">{linkLabels[key]}</a>
              ))}
            </p>
          </div>
        </article>
      ))}
    </div>
  </section>
))}
</main><Footer/></body></html>
