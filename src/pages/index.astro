---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import projects from '../data/projects.json';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { url } from '../utils/paths';
const featured = projects.slice(0,3);
---
<html lang="pt-BR">
<head><BaseHead title={`${SITE_TITLE} | Universidade Federal de Alagoas`} description={SITE_DESCRIPTION} /></head>
<body><Header /><main>
<section class="hero"><p class="eyebrow">Universidade Federal de Alagoas · Faculdade de Letras</p><h1>Estudos em Fonética e Fonologia</h1><p class="lead">O fonUFAL desenvolve pesquisa teórico-experimental sobre os sons, a prosódia e o processamento da linguagem, articulando descrição linguística, métodos experimentais, tecnologias da fala e documentação.</p></section>
<section class="section"><h2>Pesquisa em destaque</h2><div class="grid">{featured.map(p => <article class="card"><span class="badge">{p.status}</span><h3><a href={url(`/projects/${p.id}`)}>{p.title}</a></h3><p>{p.description}</p></article>)}</div><p><a href={url('/projects')}>Ver todos os projetos →</a></p></section>
<section class="section"><h2>Linhas de atuação</h2><div class="grid"><div class="card"><h3>Prosódia e discurso</h3><p>Produção e percepção de fronteiras, estruturação do discurso e processamento em tempo real.</p></div><div class="card"><h3>Fonética experimental</h3><p>Análise acústica, percepção da fala, rastreamento ocular, EEG e métodos multimodais.</p></div><div class="card"><h3>Tecnologias da fala</h3><p>Síntese de fala, naturalidade, avaliação de TTS, métricas automáticas e ciência aberta.</p></div></div></section>
<section class="section"><div class="callout"><h2>Diversidade & Inclusão</h2><p>O fonUFAL mantém o compromisso público do site atual com um ambiente acadêmico acolhedor, respeitoso e inclusivo. O texto integral será migrado da fonte WordPress durante a fase de preservação.</p></div></section>
</main><Footer /></body></html>
